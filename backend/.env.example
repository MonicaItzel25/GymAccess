# Configuración de la base de datos MySQL local
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=gym_app
DB_PASSWORD=cambia_esta_contraseña
DB_NAME=gym_db

# Autenticación JWT
JWT_SECRET=genera_aqui_un_secreto_largo_y_aleatorio
JWT_EXPIRACION_HORAS=8

# Servidor
PUERTO=3001

# Reconocimiento facial (Sprint 2)
# Umbral de coincidencia facial: distancia euclidiana máxima aceptada entre
# descriptores. Menor valor = más estricto. No es un secreto; es un ajuste de
# operación (research.md §5).
FACE_MATCH_THRESHOLD=0.5
